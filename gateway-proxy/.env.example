# --- Upstream Vercel AI Gateway ---
# Your AI Gateway API key (required).
# If you have fx CLI installed, the key is at ~/.fx/api-key
# Or create one at: https://vercel.com/d?to=%2F%5Bteam%5D%2F~%2Fai-gateway%2Fapi-keys
#
# Multiple keys (optional): list them as AI_GATEWAY_API_KEY_1 .. _20.
# The proxy always uses the first key until it fails, then transparently
# falls back to the next key and retries. The legacy single-key var
# AI_GATEWAY_API_KEY still works and takes priority as key 1; a
# comma-separated list is also accepted there.
AI_GATEWAY_API_KEY=

# --- Key pool switches ---
# On a key-attributable failure (401/402/403/408/429, any 5xx, or network
# error) transparently retry the next key before returning an error.
KEY_FAILOVER=1
# Seconds a failing key sits out of rotation before being retried.
# 0 disables cooldown. If every key is cooling, the coolest is still used so
# the proxy degrades instead of dying.
KEY_COOLDOWN=30
# Background key healer: probes cooling keys with a cheap authenticated
# GET /v1/models sweep and restores any that answer 200 to rotation before
# their full cooldown elapses (0 = disable).
KEY_HEALER=1
KEY_HEAL_INTERVAL=15

# Optional: pin a Vercel team so x-vercel-ai-gateway-team is sent.
GATEWAY_TEAM=

# Base URL of the Gateway.
# GATEWAY_BASE_URL=https://ai-gateway.vercel.sh

# --- Proxy auth ---
# Key that callers (other CLIs) must send as Bearer token.
# If empty, proxy is open (no auth required).
PROXY_API_KEY=

# --- Behaviour ---
# Default model when the client does not specify one.
# zai/glm-5.2 works without a credit card on file (free tier).
DEFAULT_MODEL=zai/glm-5.2

# Upstream connection timeouts (seconds).
GATEWAY_TIMEOUT_CONNECT=15
GATEWAY_TIMEOUT_READ=300
GATEWAY_TIMEOUT_WRITE=60
GATEWAY_TIMEOUT_POOL=60

# Use HTTP/2 to the gateway (1/0).
GATEWAY_HTTP2=1

# How long to cache the /v1/models list before refetching (seconds).
MODELS_CACHE_TTL=300

# Server bind.
HOST=0.0.0.0
PORT=8787

# Streaming responses: include usage on the final chunk by default.
# Clients can override per-request via stream_options.include_usage.
# (No env var needed; default is true.)

# Logging: DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# --- fx identity alignment ---
# The proxy auto-syncs its fx identity (User-Agent + protocol headers) from
# the vercel-labs/fx repo (latest release tag + raw gateway client source)
# every FX_REFRESH_SECS. Disable with FX_AUTO_UPDATE=0.
# Set FX_USER_AGENT to pin the User-Agent manually (never auto-overwritten).
# FX_AUTO_UPDATE=1
# FX_REFRESH_SECS=3600
# FX_USER_AGENT=

# Models that receive the body-level headers.user-agent.
# "*" = all models, "" = none, else comma-separated model ids.
# PRODUCT_USER_AGENT_MODELS=zai/glm-5.2

# Optional session pinning headers (also forwarded from inbound requests).
# GATEWAY_SESSION_ID=
# GATEWAY_SESSION_AFFINITY=

# --- Remote image fetching (fx parity) ---
# Download remote image_url parts into data URLs before sending upstream,
# mirroring how fx fetches attachments locally. Failures pass the URL through.
IMAGE_FETCH=1
IMAGE_FETCH_TIMEOUT=10
# Max image size in bytes (default 5 MiB).
IMAGE_FETCH_MAX_BYTES=5242880

# --- fx identity fallback ---
# When the GitHub sync is off/unreachable, use a locally installed fx CLI's
# version for the User-Agent instead of the hardcoded default.
# (Automatic; no env var needed.)

# --- Usage accounting ---
# SQLite-backed per-caller request/token counters, visible at /v1/usage,
# /v1/dashboard, and in the "usage" section of /healthz. Set 0 to disable.
USAGE_TRACKING=1
# Path to the SQLite database file (default: usage.db in the working dir).
# USAGE_DB_PATH=usage.db
